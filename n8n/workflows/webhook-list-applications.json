    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const headers = $input.first().json.headers || {};\nconst secret = headers['x-jobpilot-secret'] || headers['X-JobPilot-Secret'] || '';\nconst expected = $env.JOBPILOT_INGEST_SECRET || '';\n\nif (!expected || secret !== expected) {\n  throw new Error('Unauthorized');\n}\n\nreturn $input.all();"
      },
      "id": "f1a2b3c4-0002-4000-8000-000000000002",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
