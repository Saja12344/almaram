        "filters": {},
        "returnAll": true,
        "orderBy": false
      },
      "id": "f1a2b3c4-0003-4000-8000-000000000003",
      "name": "Get job_applications",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [680, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.external_id)\n  .sort((a, b) => new Date(b.date_found || 0) - new Date(a.date_found || 0));\n\nreturn [{ json: { applications: rows, count: rows.length } }];"
      },
